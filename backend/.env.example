# =============================================================================
# SmartIntern-ET — Backend Environment Template (.env.example)
# Node.js & Express Architecture
# =============================================================================

# Server & Runtime
PORT=8000
NODE_ENV=development
DEBUG=true
SITE_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# =============================================================================
# PostgreSQL Database
# =============================================================================
POSTGRES_DB=ai_internship
POSTGRES_USER=ai_user
POSTGRES_PASSWORD=ai_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ai_user:ai_password@localhost:5432/ai_internship

# =============================================================================
# Redis Cache & Queue
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# JWT Authentication & Security
# =============================================================================
JWT_SECRET=your-secret-key-change-in-production
JWT_ACCESS_EXPIRATION=2h
JWT_REFRESH_EXPIRATION=7d

# =============================================================================
# Email SMTP Configuration
# =============================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_SSL=true
DEFAULT_FROM_EMAIL=your-email@gmail.com

# =============================================================================
# Google OAuth 2.0 (Optional)
# =============================================================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FRONTEND_OAUTH_CALLBACK_URL=http://localhost:5173/auth/callback

# =============================================================================
# AI & Machine Learning Configuration
# =============================================================================
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
OPENAI_API_KEY=your-openai-api-key

# =============================================================================
# Object Storage (filesystem for local dev / S3 for cloud)
# =============================================================================
STORAGE_BACKEND=filesystem
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=

# =============================================================================
# Notifications & SMS
# =============================================================================
TELEGRAM_BOT_TOKEN=
ETHIO_SMS_API_KEY=

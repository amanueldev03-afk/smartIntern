# =============================================================================
# SmartIntern-ET — Root Environment Configuration Template (.env.example)
# Node.js & Express Backend + React & Vite Frontend
# =============================================================================

# Server & Runtime Settings
PORT=8000
NODE_ENV=development
DEBUG=true
SITE_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# =============================================================================
# PostgreSQL Database (Local Dev / Native / Docker)
# =============================================================================
POSTGRES_DB=smartintern_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartintern_db

# =============================================================================
# Redis Cache & Task Queue
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# JWT Authentication & Core Security
# =============================================================================
JWT_SECRET=supersecret-smartintern-et-key-change-in-production
JWT_ACCESS_EXPIRATION=2h
JWT_REFRESH_EXPIRATION=7d

# =============================================================================
# Email SMTP Configuration
# =============================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_SSL=true
DEFAULT_FROM_EMAIL=your-email@gmail.com

# =============================================================================
# Google OAuth 2.0 (Optional)
# =============================================================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FRONTEND_OAUTH_CALLBACK_URL=http://localhost:5173/auth/callback

# =============================================================================
# AI & Machine Learning Configuration
# =============================================================================
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
OPENAI_API_KEY=your-openai-api-key

# =============================================================================
# Object Storage (Filesystem for local dev / S3 for cloud)
# =============================================================================
STORAGE_BACKEND=filesystem
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=

# =============================================================================
# Notifications & SMS
# =============================================================================
TELEGRAM_BOT_TOKEN=
ETHIO_SMS_API_KEY=

# =============================================================================
# Frontend Specific Variables (Vite SPA)
# =============================================================================
VITE_API_BASE_URL=http://localhost:8000/api
VITE_OAUTH_BASE_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=your-google-client-id
